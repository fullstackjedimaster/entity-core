# --- Core FastAPI Server ---
PORT=8004
WORKERS=1
LOG_LEVEL=info
RELOAD=0
ACCESS_LOG=1
PUBLIC_HOST=entity-core.fullstackjedi.dev
CORS_ORIGINS=https://entity-core.fullstackjedi.dev,https://fullstackjedi.dev,https://www.fullstackjedi.dev

# --- Auth0 Configuration (PRIVATE) ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://entity-core.fullstackjedi.dev/api
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_M2M_CLIENT_ID=replace-me
AUTH0_M2M_CLIENT_SECRET=replace-me
AUTH0_MANAGEMENT_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
AUTH0_REDIRECT_SECRET=replace-with-a-long-random-secret

# The Auth0 M2M client must be authorized for Management API delete:users.

# --- Entity Server ---
EC_MODEL_BASE_URL=https://entity-server.fullstackjedi.dev
EC_SHARED_JWT_SECRET=replace-with-the-shared-entity-service-secret

# Server-to-server secret used only by the portfolio reset route.
# Generate with: openssl rand -hex 32
DEMO_RESET_SECRET=replace-with-a-different-long-random-secret

# --- Misc ---
ENABLE_LOCAL_LOGIN=0
NO_JWKS_WARMUP=0
DEBUGPY=0
