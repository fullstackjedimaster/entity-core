TZ=America/Chicago
NODE_ENV=production

# where the API listens inside container
PORT=8005

# security (if your API verifies dock/embed tokens)
# EMBED_SECRET=CHANGE_ME

# Postgres connectivity (your app should read these or DATABASE_URL—pick ONE style and stick to it)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ec
POSTGRES_USER=ec
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# created by bootstrap script
DATABASE_URL=postgresql://ec:CHANGE_ME_STRONG_PASSWORD@postgres:5432/ec?sslmode=disable

