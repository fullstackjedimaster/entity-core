POSTGRES_HOST=entity-core-postgres
POSTGRES_PORT=5432

# Bootstrap/admin connection used by the Postgres container itself
# and by init-postgres.sh to create/update the app role + app database.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# App role/database that entity-core-api will actually use.
APP_POSTGRES_DB=ec
APP_POSTGRES_USER=ec
APP_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Generated by init-env.sh
POSTGRES_DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@entity-core-postgres:5432/postgres?sslmode=disable
APP_DATABASE_URL=postgresql://ec:CHANGE_ME_STRONG_PASSWORD@entity-core-postgres:5432/ec?sslmode=disable